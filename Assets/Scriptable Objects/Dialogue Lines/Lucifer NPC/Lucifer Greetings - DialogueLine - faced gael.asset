  m_Script: {fileID: 11500000, guid: c9876f83510731f4d97169c0d46b0606, type: 3}
  m_Name: Lucifer Greetings - DialogueLine - faced gael
  m_EditorClassIdentifier: 
  lines:
  - participant: 0
    englishLine: ' I faced Gael. But he disappeared.'
    portugueseLine: Enfrentei Gael. Mas ele sumiu.
    chineseLine: "\u6211\u548CGael\u5BF9\u6218\u8FC7\u3002\u4F46\u4ED6\u6D88\u5931\u4E86\u3002"
    spanishLine: " Enfrent\xE9 a Gael. Pero desapareci\xF3."
  - participant: 1
    englishLine: " He is an angel. It\u2019s no use killing him in Hell. He must
      be killed at his place of birth. Heaven."
    portugueseLine: "Ele \xE9 um anjo. N\xE3o adianta matar ele no inferno. Ele deve
      ser morto no seu local de nascimento. O c\xE9u. "
    chineseLine: "\u4ED6\u662F\u5929\u4F7F\u3002\u6740\u4E0D\u4E86\u5728\u5730\u72F1\u91CC\u3002\u4ED6\u5F97\u5728\u51FA\u751F\u5730\u88AB\u6740\u3002\u5929\u5802\u3002"
    spanishLine: " \xC9l es un \xE1ngel. No sirve de matarlo en el infierno. Debe
      ser muerto en su lugar de nacimiento. El cielo."
