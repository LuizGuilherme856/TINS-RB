  m_Script: {fileID: 11500000, guid: c9876f83510731f4d97169c0d46b0606, type: 3}
  m_Name: Lucifer Greetings - DialogueLine 5
  m_EditorClassIdentifier: 
  lines:
  - participant: 1
    englishLine: " I think you\u2019re improving... "
    portugueseLine: "Acho que voc\xEA est\xE1 melhorando... "
    chineseLine: "\u964C\u6211\u89C9\u5F97\u4F60\u5728\u8FDB\u6B65... "
    spanishLine: " Creo que est\xE1s mejorando... "
  - participant: 0
    englishLine: " It\u2019d be easier if you explained things to me... "
    portugueseLine: "Seria mais f\xE1cil se voc\xEA me explicasse as coisas..."
    chineseLine: "\u8981\u662F\u4F60\u89E3\u91CA\u6E05\u695A\u5C31\u66F4\u597D... "
    spanishLine: " Ser\xEDa m\xE1s f\xE1cil si me explicaras las cosas... "
  - participant: 1
    englishLine: ' You are a Sacred Exorcist. The defenders of the balance between
      heaven and hell. You should know more.'
    portugueseLine: "Voc\xEA \xE9 um Exorcista Sagrado. Os defensores do equil\xEDbrio
      entre o c\xE9u e o inferno. Deveria saber mais"
    chineseLine: "\u4F60\u662F\u5723\u6D01\u9A71\u9B54\u8005\u3002\u5B88\u62A4\u5929\u5802\u4E0E\u5730\u72F1\u5E73\u8861\u7684\u634D\u536B\u8005\u3002\u4F60\u5E94\u8BE5\u77E5\u9053\u5F97\u66F4\u591A\u3002"
    spanishLine: " Eres un Exorcista Sagrado. Los defensores del equilibrio entre
      el cielo y el infierno. Deber\xEDas saber m\xE1s."
