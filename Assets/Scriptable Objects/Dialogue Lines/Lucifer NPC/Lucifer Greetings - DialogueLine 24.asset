  m_Script: {fileID: 11500000, guid: c9876f83510731f4d97169c0d46b0606, type: 3}
  m_Name: Lucifer Greetings - DialogueLine 24
  m_EditorClassIdentifier: 
  lines:
  - participant: 0
    englishLine: ' Why are you helping me so much?'
    portugueseLine: " Porque voc\xEA est\xE1 me ajudando tanto?"
    chineseLine: "\u4F60\u4E3A\u4EC0\u4E48\u5E2E\u6211\u90A3\u4E48\u591A?  "
    spanishLine: " \xBFPor qu\xE9 me est\xE1s ayudando tanto?"
  - participant: 1
    englishLine: ' Because, in the end, you will be the key to my return. I just
      need...  a little push.'
    portugueseLine: "Porque, no final, voc\xEA vai ser a chave para o meu retorno.
      Eu s\xF3 preciso... um empurr\xE3ozinho."
    chineseLine: "\u964C\u56E0\u4E3A\u6700\u7EC8\uFF0C\u4F60\u4F1A\u6210\u4E3A\u6211\u91CD\u8FD4\u5BB6\u7684\u5173\u952E\u3002\u6211\u53EA\u9700...
      \u4E00\u70B9\u63A8\u52A8\u529B\u3002"
    spanishLine: " Porque, al final, ser\xE1s la llave para mi regreso. Solo necesito... 
      un empujoncito."
  - participant: 0
    englishLine: " So you\u2019re just using me?"
    portugueseLine: " Ent\xE3o voc\xEA est\xE1 apenas me usando?"
    chineseLine: "\u6240\u4EE5\u4F60\u53EA\u662F\u5728\u5229\u7528\u6211?  "
    spanishLine: " \xBFAs\xED que solo me est\xE1s usando?"
  - participant: 1
    englishLine: " Using is a strong word. I\u2019d say it\u2019s more...  a partnership."
    portugueseLine: " Usar \xE9 uma palavra forte. Eu diria que \xE9 mais... uma
      parceria."
    chineseLine: "\u964C\u7528\u201C\u5229\u7528\u201D\u8FD9\u4E2A\u8BCD\u592A\u91CD\u3002\u6211\u4F1A\u8BF4\u8FD9\u66F4\u50CF...
      \u5408\u4F5C\u5173\u7CFB\u3002"
    spanishLine: " Usar es una palabra fuerte. Dir\xEDa que es m\xE1s...  una sociedad."
