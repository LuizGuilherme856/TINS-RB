  m_Script: {fileID: 11500000, guid: c9876f83510731f4d97169c0d46b0606, type: 3}
  m_Name: Lucifer Greetings - DialogueLine 12
  m_EditorClassIdentifier: 
  lines:
  - participant: 1
    englishLine: ' Come on, my friend. You need to finish off these demons so I can
      get home soon. This place is very cold.'
    portugueseLine: "Vamos, meu querido. Precisa acabar com esses demonios para eu
      voltar pra casa logo. Esse lugar \xE9 muito frio."
    chineseLine: "\u4F60\u8981\u5E72\u6389\u8FD9\u4E9B\u6076\u9B54\uFF0C\u8BA9\u6211\u65E9\u70B9\u56DE\u5BB6\u3002\u8FD9\u5730\u65B9\u592A\u51B7\u4E86\u3002"
    spanishLine: " Necesitas acabar con estos demonios para que pueda volver a casa
      pronto. Este lugar es muy fr\xEDo."
  - participant: 0
    englishLine: ' Is your home warmer?'
    portugueseLine: "Sua casa \xE9 mais quente?"
    chineseLine: "\u4F60\u5BB6\u66F4\u70ED\u5417?  "
    spanishLine: " \xBFTu casa es m\xE1s c\xE1lida?"
  - participant: 1
    englishLine: ' Yes...  Too warm.'
    portugueseLine: "Sim... Quente at\xE9 demais"
    chineseLine: "\u662F\u7684... ... \u70ED\u5F97\u592A\u8FC7\u3002"
    spanishLine: " S\xED...  Demasiado c\xE1lida."
