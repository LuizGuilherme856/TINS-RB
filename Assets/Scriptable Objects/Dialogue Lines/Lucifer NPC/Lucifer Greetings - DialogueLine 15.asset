  m_Name: Lucifer Greetings - DialogueLine 15
  m_EditorClassIdentifier: 
  lines:
  - participant: 0
    englishLine: " How do you know so much about Lucifer\u2019s fall?"
    portugueseLine: "Como voc\xEA sabe tanto sobre a queda de L\xFAcifer?"
    chineseLine: "\u4F60\u600E\u4E48\u77E5\u9053\u8FD9\u4E48\u591A\u5173\u4E8E\u8DEF\u897F\u6CD5\u5760\u843D\u7684?  "
    spanishLine: " \xBFC\xF3mo sabes tanto sobre la ca\xEDda de Lucifer?"
  - participant: 1
    englishLine: ' I was there... '
    portugueseLine: "Eu estava l\xE1..."
    chineseLine: "\u6211\u5728\u90A3\u91CC... "
    spanishLine: " Estuve all\xED... "
  - participant: 0
    englishLine: ' You fought in the war?'
    portugueseLine: 'Participou da guerra? '
    chineseLine: "\u4F60\u53C2\u4E0E\u6218\u4E89\u4E86?  "
    spanishLine: " \xBFParticipaste en la guerra?"
  - participant: 1
    englishLine: " It\u2019s complicated... "
    portugueseLine: "\xC9 complicado..."
    chineseLine: "\u590D\u6742... "
    spanishLine: ' Es complicado... '
