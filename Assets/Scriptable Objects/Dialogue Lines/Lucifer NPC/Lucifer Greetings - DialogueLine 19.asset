  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c9876f83510731f4d97169c0d46b0606, type: 3}
  m_Name: Lucifer Greetings - DialogueLine 19
  m_EditorClassIdentifier: 
  lines:
  - participant: 0
    englishLine: ' And who stole your throne again?'
    portugueseLine: 'E quem roubou seu trono mesmo? '
    chineseLine: "\u5230\u5E95\u662F\u8C01\u62A2\u4E86\u4F60\u738B\u4F4D?  "
    spanishLine: " \xBFY qui\xE9n rob\xF3 tu trono otra vez?"
  - participant: 1
    englishLine: " Gael. Nobody respects him. That\u2019s why there\u2019s chaos
      in Hell. Demons are already dumb enough."
    portugueseLine: "Gael. Ningu\xE9m respeita ele. Por isso a bagun\xE7a no inferno.
      Os dem\xF4nios j\xE1 s\xE3o burro que d\xF3i. "
    chineseLine: "Gael\u3002\u6CA1\u4EBA\u5C0A\u91CD\u4ED6\u3002\u6240\u4EE5\u5730\u72F1\u4E00\u56E2\u7CDF\u3002\u6076\u9B54\u4EEC\u5DF2\u7ECF\u591F\u7B28\u4E86\u3002"
    spanishLine: ' Gael. Nadie lo respeta. Por eso hay caos en el infierno. Los demonios
      ya son lo bastante tontos. '
  - participant: 1
    englishLine: " Without leadership, it becomes this mess you\u2019re seeing."
    portugueseLine: "Sem lideran\xE7a ainda... Vira esse caos que voc\xEA ta vendo"
    chineseLine: "\u6CA1\u9886\u5BFC\u624D\u53D8\u6210\u8FD9\u4E48\u4E71\u3002"
    spanishLine: "Sin liderazgo, se convierte en este caos que est\xE1s viendo."
  - participant: 0
    englishLine: " Gael? We\u2019ve fought side by side against demons... "
    portugueseLine: "Gael? J\xE1 lutamos lado a lado contra os dem\xF4nios..."
    chineseLine: "Gael?  \u6211\u4EEC\u66FE\u4E00\u8D77\u6218\u6597\u8FC7... "
    spanishLine: " \xBFGael? Hemos luchado lado a lado contra los demonios... "
