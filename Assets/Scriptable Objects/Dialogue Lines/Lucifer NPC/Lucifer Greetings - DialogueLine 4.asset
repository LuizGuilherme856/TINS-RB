  m_Script: {fileID: 11500000, guid: c9876f83510731f4d97169c0d46b0606, type: 3}
  m_Name: Lucifer Greetings - DialogueLine 4
  m_EditorClassIdentifier: 
  lines:
  - participant: 1
    englishLine: " That was fast. Doesn\u2019t even look like you understood how
      Blood Points work... "
    portugueseLine: "Essa foi r\xE1pida. Nem parece que voc\xEA entendeu como os
      Pontos de Sangue funcionam..."
    chineseLine: "\u597D\u5FEB\u3002\u770B\u8D77\u6765\u4F60\u8FDE\u201C\u8840\u70B9\u201D\u600E\u4E48\u7528\u90FD\u6CA1\u5F04\u61C2... "
    spanishLine: " Eso fue r\xE1pido. Ni parece que entendiste c\xF3mo funcionan
      los Puntos de Sangre... "
  - participant: 0
    englishLine: " YOU DIDN\u2019T EXPLAIN!"
    portugueseLine: "VOC\xCA N\xC3O EXPLICOU!"
    chineseLine: "\u4F60\u6CA1\u89E3\u91CA!  "
    spanishLine: " \xA1NO EXPLICASTE!"
  - participant: 1
    englishLine: " Just because I didn\u2019t explain doesn\u2019t excuse you from
      not learning."
    portugueseLine: "S\xF3 porque eu n\xE3o expliquei n\xE3o \xE9 desculpa para n\xE3o
      ter aprendido."
    chineseLine: "\u6211\u6CA1\u89E3\u91CA\u4E5F\u4E0D\u662F\u4F60\u6CA1\u5B66\u4F1A\u7684\u501F\u53E3\u3002"
    spanishLine: " Solo porque no expliqu\xE9 no es excusa para no haber aprendido."
