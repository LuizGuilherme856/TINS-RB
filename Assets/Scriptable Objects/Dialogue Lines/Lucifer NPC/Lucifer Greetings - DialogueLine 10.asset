  m_Script: {fileID: 11500000, guid: c9876f83510731f4d97169c0d46b0606, type: 3}
  m_Name: Lucifer Greetings - DialogueLine 10
  m_EditorClassIdentifier: 
  lines:
  - participant: 1
    englishLine: ' How many times did you fail at exorcist school?'
    portugueseLine: "Quantas vezes voc\xEA rodou na escola de exorcistas?"
    chineseLine: "\u964C\u4F60\u5728\u9A71\u9B54\u5B66\u6821\u6302\u8FC7\u51E0\u6B21?  "
    spanishLine: " \xBFCu\xE1ntas veces reprobaste la escuela de exorcistas?"
  - participant: 0
    englishLine: " I didn\u2019t go to any school. I was born this way."
    portugueseLine: "Eu n\xE3o fui a nenhuma escola. Nasci assim."
    chineseLine: "\u6211\u6CA1\u4E0A\u8FC7\u5B66\u6821\u3002\u6211\u5929\u751F\u5C31\u662F\u8FD9\u6837\u3002"
    spanishLine: " No fui a ninguna escuela. Nac\xED as\xED."
  - participant: 1
    englishLine: ' Poor thing.'
    portugueseLine: Coitadinho
    chineseLine: "\u964C\u53EF\u601C\u3002"
    spanishLine: ' Pobrecito.'
