  m_Script: {fileID: 11500000, guid: c9876f83510731f4d97169c0d46b0606, type: 3}
  m_Name: Lucifer Greetings - DialogueLine 23
  m_EditorClassIdentifier: 
  lines:
  - participant: 1
    englishLine: " I feel you\u2019re beginning to understand the situation."
    portugueseLine: " Sinto que est\xE1 come\xE7ando a entender a situa\xE7\xE3o."
    chineseLine: "\u6211\u611F\u89C9\u4F60\u5F00\u59CB\u660E\u767D\u72B6\u6CC1\u4E86\u3002"
    spanishLine: "Siento que empiezas a entender la situaci\xF3n."
  - participant: 0
    englishLine: " I\u2019m starting to think I don\u2019t understand anything."
    portugueseLine: "T\xF4 come\xE7ando a achar que n\xE3o estou entendendo nada"
    chineseLine: "\u6211\u5F00\u59CB\u89C9\u5F97\u6211\u4EC0\u4E48\u90FD\u4E0D\u61C2\u3002"
    spanishLine: ' Estoy empezando a creer que no entiendo nada.'
