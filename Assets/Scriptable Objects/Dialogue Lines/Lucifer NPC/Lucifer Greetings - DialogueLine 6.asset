  m_Script: {fileID: 11500000, guid: c9876f83510731f4d97169c0d46b0606, type: 3}
  m_Name: Lucifer Greetings - DialogueLine 6
  m_EditorClassIdentifier: 
  lines:
  - participant: 1
    englishLine: " This time you smashed the demons\u2019 fists with your face."
    portugueseLine: "Dessa vez voc\xEA quebrou o punho dos demonios com a sua cara."
    chineseLine: "\u8FD9\u6B21\u4F60\u7528\u8138\u628A\u6076\u9B54\u62F3\u5934\u7ED9\u7838\u788E\u4E86\u3002"
    spanishLine: " Esta vez rompiste los pu\xF1os de los demonios con tu cara."
  - participant: 0
    englishLine: ' Ok, man. Who are you?'
    portugueseLine: "Ta, cara. Quem \xE9 voc\xEA?"
    chineseLine: "\u884C\u4E86\uFF0C\u4F19\u8BA1\u3002\u4F60\u5230\u5E95\u662F\u8C01?  "
    spanishLine: " Ok, hermano. \xBFQui\xE9n eres?"
  - participant: 1
    englishLine: " Right, manners. Call me Mr. Crowley. I\u2019m an Angel."
    portugueseLine: "Verdade, aonde est\xE3o meus modos. Me chame de Mr Crowley.
      Sou um Anjo."
    chineseLine: "\u5BF9\uFF0C\u89C4\u77E9\u3002\u53EB\u6211\u514B\u52B3\u5229\u5148\u751F\u3002\u6211\u662F\u5929\u4F7F\u3002"
    spanishLine: " Cierto, modales. Ll\xE1mame Mr. Crowley. Soy un \xC1ngel."
  - participant: 0
    englishLine: ' There is NO angel with that name.'
    portugueseLine: "N\xE3o existe NENHUM anjo com esse nome."
    chineseLine: "\u6CA1\u6709\u4EFB\u4F55\u4E00\u4E2A\u5929\u4F7F\u53EB\u8FD9\u4E2A\u540D\u5B57\u3002"
    spanishLine: " No existe NING\xDAN \xE1ngel con ese nombre."
  - participant: 1
    englishLine: ' Quiet.'
    portugueseLine: 'Calado. '
    chineseLine: "\u95ED\u5634\u3002"
    spanishLine: ' Calla.'
