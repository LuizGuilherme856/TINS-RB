  m_Script: {fileID: 11500000, guid: c9876f83510731f4d97169c0d46b0606, type: 3}
  m_Name: Lucifer Greetings - DialogueLine 8
  m_EditorClassIdentifier: 
  lines:
  - participant: 1
    englishLine: ' Good m...  I mean, just good'
    portugueseLine: Bom d.. Digo, apenas bom
    chineseLine: "\u65E9... \u6211\u8BF4\uFF0C\u53EA\u662F\u597D"
    spanishLine: ' Buenos d...  Digo, solo buenos'
  - participant: 0
    englishLine: " I guess you don\u2019t have many friends. That\u2019s why you\u2019re
      here acting like a smart guy."
    portugueseLine: "Acho que voc\xEA n\xE3o deve ter muitos amigos. Por isso ta
      aqui pagando de sabich\xE3o. "
    chineseLine: "\u6211\u731C\u4F60\u6CA1\u591A\u5C11\u670B\u53CB\uFF0C\u6240\u4EE5\u624D\u5728\u8FD9\u513F\u88C5\u806A\u660E\u3002"
    spanishLine: " Creo que no tienes muchos amigos. Por eso est\xE1s aqu\xED de
      sabelotodo."
  - participant: 1
    englishLine: " I was expelled from my home by demons, little exorcist. You should
      be grateful that I\u2019m helping you."
    portugueseLine: "Eu fui expulso do meu lar pelos dem\xF4nios, meu querido. Voc\xEA
      deveria ser grato por eu estar te ajudando"
    chineseLine: "\u6211\u88AB\u6076\u9B54\u8D76\u51FA\u5BB6\u56ED\u4E86\u3002\u4F60\u5E94\u5F53\u611F\u8C22\u6211\u5728\u5E2E\u4F60\u3002"
    spanishLine: " Fui expulsado de mi hogar por los demonios. Deber\xEDas estar
      agradecido de que te est\xE9 ayudando."
