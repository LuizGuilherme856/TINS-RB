  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c9876f83510731f4d97169c0d46b0606, type: 3}
  m_Name: Lucifer Greetings - DialogueLine 11
  m_EditorClassIdentifier: 
  lines:
  - participant: 0
    englishLine: ' I admit that this Chalice you gave me is pretty useful.'
    portugueseLine: "Admito que esse C\xE1lice que voc\xEA me deu \xE9 bem \xFAtil"
    chineseLine: "\u6211\u627F\u8BA4\u4F60\u7ED9\u6211\u7684\u8FD9\u4E2A\u5723\u676F\u786E\u5B9E\u633A\u6709\u7528\u3002"
    spanishLine: "Admito que este C\xE1liz que me diste es bastante \xFAtil."
  - participant: 1
    englishLine: ' It is. I won it in a bet in Hell.'
    portugueseLine: "Ele \xE9. Ganhei numa aposta no inferno."
    chineseLine: "\u964C\u786E\u5B9E\u3002\u6211\u5728\u5730\u72F1\u6253\u8D4C\u8D62\u4E86\u3002"
    spanishLine: " Lo es. Lo gan\xE9 en una apuesta en el Infierno."
  - participant: 0
    englishLine: ' What was an angel doing in Hell?'
    portugueseLine: O que um anjo fazia no inferno?
    chineseLine: "\u5929\u4F7F\u8DD1\u5230\u5730\u72F1\u5E72\u561B?  "
    spanishLine: " \xBFQu\xE9 hac\xEDa un \xE1ngel en el infierno?"
  - participant: 1
    englishLine: ' Long story, my little friend. Long story.'
    portugueseLine: "Longa hist\xF3ria, meu querido. Longa hist\xF3ria"
    chineseLine: "\u8BF4\u6765\u8BDD\u957F\u3002\u8BF4\u6765\u8BDD\u957F\u3002"
    spanishLine: " Historia larga, peque\xF1o. Historia larga."
