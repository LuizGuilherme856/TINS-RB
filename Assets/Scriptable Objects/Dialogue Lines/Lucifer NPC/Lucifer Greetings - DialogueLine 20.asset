  lines:
  - participant: 0
    englishLine: ' Dude, this is already tiring.'
    portugueseLine: "Cara, isso j\xE1 ta cansando. "
    chineseLine: "\u54E5\u4EEC\uFF0C\u6211\u7D2F\u4E86\u3002"
    spanishLine: " Amigo, esto ya est\xE1 cansando."
  - participant: 1
    englishLine: ' Relax. I believe in you.'
    portugueseLine: "Relaxa. Acredito em voc\xEA"
    chineseLine: "\u653E\u8F7B\u677E\u3002\u6211\u76F8\u4FE1\u4F60\u3002"
    spanishLine: " Rel\xE1jate. Creo en ti."
