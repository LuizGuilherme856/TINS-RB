  m_Script: {fileID: 11500000, guid: c9876f83510731f4d97169c0d46b0606, type: 3}
  m_Name: Lucifer Greetings - DialogueLine 7
  m_EditorClassIdentifier: 
  lines:
  - participant: 1
    englishLine: ' Good morning'
    portugueseLine: Bom dia
    chineseLine: "\u65E9\u4E0A\u597D"
    spanishLine: " Buenos d\xEDas"
  - participant: 0
    englishLine: " \u201CGood morning\u201D? We\u2019re in the Void, a dimension
      orthogonal to Earth\u2019s dimensional axis. The concept of day or night doesn\u2019t
      apply here."
    portugueseLine: "Bom dia? Estamos no Vazio, uma dimens\xE3o ortogonal ao eixo
      dimensional da terra. O conceito de dia ou noite n\xE3o se aplica aqui."
    chineseLine: "\u201C\u65E9\u4E0A\u597D\u201D?  \u6211\u4EEC\u5728\u865A\u7A7A\uFF0C\u4E00\u4E2A\u4E0E\u5730\u7403\u7EF4\u5EA6\u8F74\u5782\u76F4\u7684\u6B21\u5143\u3002\u8FD9\u91CC\u4E0D\u5B58\u5728\u663C\u591C\u7684\u6982\u5FF5\u3002"
    spanishLine: " \xBF\u201CBuenos d\xEDas\u201D? Estamos en el Vac\xEDo, una dimensi\xF3n
      ortogonal al eje dimensional de la Tierra. El concepto de d\xEDa o noche no
      aplica aqu\xED."
  - participant: 1
    englishLine: " I stopped paying attention at \u201Corthogonal dimension\u201D... "
    portugueseLine: "Eu parei de prestar aten\xE7\xE3o em \"dimens\xE3o ortogonal\"..."
    chineseLine: "\u6211\u5728\u201C\u5782\u76F4\u6B21\u5143\u201D\u90A3\u53E5\u8BDD\u5C31\u6CA1\u542C\u4E0B\u53BB... "
    spanishLine: " Dej\xE9 de prestar atenci\xF3n en \u201Cdimensi\xF3n ortogonal\u201D... "
