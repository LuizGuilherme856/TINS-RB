    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: lineChinese.Array.data[3]
      value: "\u8BB0\u5F97\u591A\u559D\u6C34"
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: lineEnglish.Array.data[0]
      value: When I grow up, I want to be a bear.
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: lineEnglish.Array.data[1]
      value: Oh my God, I can't feel my fingers!
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: lineEnglish.Array.data[2]
      value: Straighten your back, my friend
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: lineEnglish.Array.data[3]
      value: Did you drink water today?
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: lineEnglish.Array.data[4]
      value: 'WTF is a kilometer? '
