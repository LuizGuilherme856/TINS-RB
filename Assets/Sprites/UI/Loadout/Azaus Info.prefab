--- !u!114 &2143928656203315199
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2289566396630038847}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4fa915321fb82c3409e875adb8383ed9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  languageData: {fileID: 11400000, guid: eb0c907e1bf9b3e4b9c51bdece2e7eb6, type: 2}
  changeFontOnly: 0
  fontWithTexture: 0
  simpleFont: 1
  englishText: "\tAzaus is not necessarily a good being, but due to his relentless
    hunt for demons and his hatred for them, he has gained a positive reputation
    for helping humans. The only issue is that he seems to not care much about the
    well-being of the people around him.\n\n\nOnce, he destroyed an entire village
    to kill a demon spider..."
  chineseText: "Azaus\u4E0D\u80FD\u8BF4\u662F\u4EC0\u4E48\u5927\u597D\u4EBA\uFF0C\u4E0D\u8FC7\u7531\u4E8E\u4ED6\u5BF9\u6076\u9B54\u7684\u65E0\u5C3D\u618E\u6068\u548C\u65E0\u6B62\u5883\u5730\u8FFD\u6740\uFF0C\u4ED6\u8FD8\u662F\u83B7\u5F97\u4E86\u52A9\u4EBA\u4E3A\u4E50\u7684\u540D\u58F0\u3002\u552F\u4E00\u7684\u95EE\u9898\u662F\u4ED6\u4F3C\u4E4E\u4E5F\u4E0D\u592A\u5173\u5FC3\u4EBA\u7C7B\u7684\u5B89\u5168\u3002\u66FE\u7ECF\uFF0C\u4ED6\u4E3A\u4E86\u62CD\u6B7B\u4E00\u53EA\u5C0F\u5C0F\u7684\u6076\u9B54\u8718\u86DB\uFF0C\u6467\u6BC1\u4E86\u4E00\u6574\u4E2A\u5C0F\u9547\u3002"
  portugueseText: "\tAzaus n\xE3o \xE9 necessariamente um ser do bem, mas devido
    \xE0 sua implac\xE1vel ca\xE7a aos dem\xF4nios e seu \xF3dio por eles, ele ganhou
    uma reputa\xE7\xE3o positiva de ajudar os humanos. O \xFAnico problema \xE9 que
    ele parece n\xE3o se importar muito com o bem-estar das pessoas ao seu redor.
    \r\n\r\nUma vez ele destruiu uma vila inteira para matar uma aranha dem\xF4nio\u2026"
  spanishText: 
