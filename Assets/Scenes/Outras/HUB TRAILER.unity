--- !u!114 &1202291698948956431
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1202291698948956429}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 735986839b2a7064b8dda634f9177e37, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcPos: {fileID: 1202291700406518528}
  englishLines:
  - Hey, buddy!
  - The demons are on the loose.
  - They're coming from the old Church! I need you to go there and investigate what's
    happening.
  - Why you? Because I'm ordering you!
  - And you obey. Everyone obeys the duck!
  englishObjective: 
  chineseLines:
  - "\u563F\uFF01"
  - "\u6076\u9B54\u5728\u5916\u9762\u778E\u6E9C\u8FBE!   "
  - "\u4ED6\u4EEC\u6765\u81EA\u65E7\u6559\u5802!  \u6211\u9700\u8981\u4F60\u53BB\u90A3\u91CC\u770B\u770B\u600E\u4E48\u56DE\u4E8B!   "
  - "\u4E3A\u4EC0\u4E48?   \u56E0\u4E3A\u6211\u662F\u4F60\u7684\u4E0A\u53F8!"
  - "\u4F60\u4F1A\u670D\u4ECE\u7684\u3002\u6BCF\u4E2A\u4EBA\u90FD\u670D\u4ECE\u9E2D\u5B50!"
  chineseObjective: 
  portugueseLines:
  - 'Eai, amigo! '
  - "Os dem\xF4nios est\xE3o a solta."
  - "Eles est\xE3o vindo da antiga Igreja! Preciso que v\xE1 la e investigue o que
    esta acontecendo"
  - "Por que voc\xEA? Por que eu t\xF4 mandando! "
  - "E voc\xEA obedece. Todos obedecem o pato!"
  portugueseObjective: 
  changeObjShader: 0
  objSpriteRenderer: {fileID: 0}
  changeLineAutomaticallyWhenComplete: 1
  isConversation: 1
  dialogueSystem: {fileID: 6962379412410424125}
