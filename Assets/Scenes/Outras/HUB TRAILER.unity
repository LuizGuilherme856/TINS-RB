    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: lineChinese.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: lineEnglish.Array.size
      value: 10
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: lineChinese.Array.data[0]
      value: ....
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: lineEnglish.Array.data[0]
      value: Don't trust the duck...
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: lineEnglish.Array.data[1]
      value: I lost all my money gambling again yesterday.
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: lineEnglish.Array.data[2]
      value: Can you lend me some money? I'll pay you back... someday.
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: lineEnglish.Array.data[3]
      value: I love feet.
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: lineEnglish.Array.data[4]
      value: How about some chicken?
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: lineEnglish.Array.data[5]
      value: Huh?
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: lineEnglish.Array.data[6]
      value: I'm not saying I'm batm4n, but you've never seen me and him in the same
        place.
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: lineEnglish.Array.data[7]
      value: I don't like Hanba. He doesn't have feet...
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: lineEnglish.Array.data[8]
      value: I'm still going to destroy all the toilet paper rolls in the world...
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: lineEnglish.Array.data[9]
      value: Who needs a scratching post when you have a whole couch to scratch?
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: linePortuguese.Array.size
      value: 10
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: linePortuguese.Array.data[0]
      value: "N\xE3o confie no pato\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: linePortuguese.Array.data[1]
      value: Perdi todo meu dinheiro em apostas de novo ontem
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: linePortuguese.Array.data[2]
      value: "Me empresta dinheiro? Eu devolvo\u2026 algum dia."
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: linePortuguese.Array.data[3]
      value: "Adoro p\xE9s"
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: linePortuguese.Array.data[4]
      value: Que tal um franguinho?
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: linePortuguese.Array.data[5]
      value: 'Hum? '
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: linePortuguese.Array.data[6]
      value: "N\xE3o estou dizendo que eu seja o batima, mas voc\xEA nunca viu eu
        e ele no mesmo lugar"
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: linePortuguese.Array.data[7]
      value: "Vende pack do p\xE9?"
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: linePortuguese.Array.data[8]
      value: "Ainda vou destruir todos os rolos de pap\xE9is higi\xEAnicos do mundo..."
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: linePortuguese.Array.data[9]
      value: "quem precisa de arranhador quando se tem um sof\xE1 inteiro pra arranhar?"
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032525, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: m_Name
      value: NPC behaviour
      objectReference: {fileID: 0}
    m_RemovedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
