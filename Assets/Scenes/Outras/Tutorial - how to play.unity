      value: 
      objectReference: {fileID: 1902735499}
    - target: {fileID: 8825811854931453545, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854931453545, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854931453545, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854931453545, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[0]
      value: "\u5728\u8FD9\u91CC\u8D2D\u4E70\u6B66\u5668"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854931453545, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[1]
      value: "\u6211\u771F\u4E0D\u77E5\u9053\uFF0C\u8C01\u628A\u67AA\u6254\u5728\u8FD9\u4E86"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854931453545, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[2]
      value: "\u4F60\u5728\u7B49\u4EC0\u4E48?"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854931453545, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[3]
      value: "\u636E\u4ED6\u4EEC\u8BF4\uFF0C\u6211\u662F\u4E2A\u6709\u6CE8\u610F\u529B\u7F3A\u9677\u591A\u52A8\u75C7\u7684\u9E2D\u5B50"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854931453545, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[0]
      value: Now buy this weapon here.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854931453545, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[1]
      value: I honestly don't know who left this weapon here.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854931453545, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[2]
      value: What are you waiting for?
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854931453545, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[3]
      value: And they say I'm the one with ADHD.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854931453545, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854931453545, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[0]
      value: "Ahora compra esta arma aqu\xED."
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854931453545, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[1]
      value: "Honestamente, no s\xE9 qui\xE9n dej\xF3 esta arma aqu\xED."
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854931453545, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[2]
      value: "\xBFQu\xE9 est\xE1s esperando?"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854931453545, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[3]
      value: Y dicen que yo soy el que tiene TDAH.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854931453545, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[0]
      value: Agora compre essa arma aqui
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854931453545, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[1]
      value: "Eu sinceramente n\xE3o sei quem deixou essa arma a\xED."
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854931453545, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[2]
      value: Ta esperando o que, MALUCO?
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854931453545, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[3]
      value: Depois eu que tenho TDAH.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.size
      value: 15
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.size
      value: 15
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.size
      value: 15
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[0]
      value: "\u4F60\u771F\u662F\u4E86\u4E0D\u8D77!"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[1]
      value: "\u4F60\u5C60\u6740\u6076\u9B54\u8D8A\u6765\u8D8A\u719F\u7EC3\u4E86!"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[2]
      value: "\u5F53\u4F60\u6740\u6B7B\u6076\u9B54\uFF0C\u4F60\u83B7\u5F97\u8840\u6DB2\u70B9\u6570"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[3]
      value: "\u5DE6\u4E0B\u89D2\u7684\u6570\u5B57\u663E\u793A\u4E86\u4F60\u62E5\u6709\u7684\u70B9\u6570"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[4]
      value: "\u4F60\u53EF\u4EE5\u7528\u70B9\u6570\u8D2D\u4E70\u6B66\u5668\uFF0C\u5F39\u836F\uFF0C\u8FD8\u6709\u5347\u7EA7"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[5]
      value: "\u6211\u77E5\u9053\u8FD9\u4E0D\u5408\u5E38\u7406...."
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[6]
      value: "\u4F46\u4F60\u8FD8\u53EF\u4EE5\u7528\u70B9\u6570\u6765\u6253\u5F00\u8FD9\u4E9B\u95E8"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[7]
      value: "\u62B1\u6B49\uFF0C\u6211\u77E5\u9053\u8FD9\u6CA1\u9053\u7406\uFF0C\u4F46\u8FD9\u4E0D\u662F\u6211\u7684\u9519..."
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[8]
      value: "\u56E0\u4E3A\u6211\u53EA\u662F\u4E00\u53EA\u5C0F\u9EC4\u9E2D!"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[9]
      value: "\u5582\uFF0C\u4E0D\u8981\u90A3\u6837\u770B\u7740\u6211"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[0]
      value: You're amazing!
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[1]
      value: You're getting good at killing demons!
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[2]
      value: When you kill demons, you earn Blood Points.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[3]
      value: Those numbers in the bottom left corner of the screen are your points.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[4]
      value: You can use your points to buy weapons, ammunition, and upgrades.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[5]
      value: I know it doesn't make sense...
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[6]
      value: But you can also open doors with the points.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[7]
      value: Sorry, I know it doesn't make sense, but it's not my fault :(
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[8]
      value: I'm just a DUCK!
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[9]
      value: Hey, don't look at me like that.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.size
      value: 15
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[0]
      value: "\xA1Eres incre\xEDble!"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[1]
      value: "Te est\xE1s volviendo bueno matando demonios."
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[2]
      value: Cuando matas demonios, ganas Puntos de Sangre.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[3]
      value: "Esos n\xFAmeros en la esquina inferior izquierda de la pantalla son
        tus puntos."
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[4]
      value: "Puedes usar tus puntos para comprar armas, munici\xF3n y mejoras."
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[5]
      value: "S\xE9 que no tiene sentido..."
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[6]
      value: "Pero tambi\xE9n puedes abrir puertas con los puntos."
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[7]
      value: "Lo siento, s\xE9 que no tiene sentido, pero no es mi culpa :("
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[8]
      value: "\xA1Solo soy un PATO!"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[9]
      value: "Oye, no me mires as\xED."
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[10]
      value: "\u8981\u602A\u5C31\u602A\u90A3\u4E2A\u4F5C\u8005 @MrGranade1"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[11]
