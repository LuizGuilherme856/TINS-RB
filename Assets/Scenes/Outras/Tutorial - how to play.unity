      propertyPath: chineseLines.Array.data[14]
      value: "\u5BF9\uFF0C\u8BF4\u5230\u90A3\u4E9B\u95E8"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[10]
      value: Blame @MrGranade1.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[11]
      value: The developer is a Zombies fan.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[12]
      value: Oh, heavens, I got distracted.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[13]
      value: Where were we?
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[14]
      value: Ah, yes, the doors.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[10]
      value: Culpa a @MrGranade1.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[11]
      value: El desarrollador es fan de Zombies.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[12]
      value: Oh, cielos, me distraje.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[13]
      value: "\xBFD\xF3nde est\xE1bamos?"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[14]
      value: "Ah, s\xED, las puertas."
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[0]
      value: "Voc\xEA \xE9 demais! "
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[1]
      value: "Voc\xEA est\xE1 ficando bom em matar dem\xF4nios!"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[2]
      value: "Quando voc\xEA mata os dem\xF4nios, voc\xEA consegue Pontos de Sangue."
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[3]
      value: "Aqueles n\xFAmeros no canto inferior esquerdo da tela s\xE3o seus pontos."
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[4]
      value: "Voc\xEA pode usar seus pontos para comprar armas, muni\xE7\xE3o e upgrades."
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[5]
      value: "Eu sei que n\xE3o faz sentido\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[6]
      value: "Mas voc\xEA pode abrir portas tamb\xE9m com os pontos."
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[7]
      value: "Desculpa eu sei que n\xE3o faz sentido, mas eu n\xE3o tenho culpa :("
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[8]
      value: Eu sou apenas um PATO!
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[9]
      value: "Ei, n\xE3o me olhe assim."
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[10]
      value: Culpe @MrGranade1
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[11]
      value: "Desenvolvedor \xE9 f\xE3 de Zombies."
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[12]
      value: "Oh, c\xE9us me distrai."
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[13]
      value: "Onde est\xE1vamos?"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854971427200, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[14]
      value: Ah sim, as portas.
      objectReference: {fileID: 0}
