    - target: {fileID: 8825811854735821020, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[0]
      value: "\u662F\u65F6\u5019\u53D8\u5F97\u66F4\u5F3A\u4E86"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854735821020, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[1]
      value: "\u770B\u5230\u8FD9\u4E2A\u795E\u50CF\u4E86?  "
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854735821020, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[2]
      value: "\u5B83\u4EE3\u8868\u4E86\u8D22\u795E\uFF0C\u6709\u4EBA\u8BF4\u8D22\u795E\u80FD\u70B9\u77F3\u6210\u91D1!"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854735821020, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[3]
      value: "\u628A\u4F60\u7684\u6B66\u5668\u653E\u8FDB\u795E\u50CF\uFF0C\u770B\u770B\u4F1A\u53D1\u751F\u4EC0\u4E48!"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854735821020, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[4]
      value: "\u5411\u795E\u50CF\u7948\u7977"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854735821020, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[5]
      value: Let's go!
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854735821020, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[0]
      value: It's time to get stronger!
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854735821020, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[1]
      value: See this statue?
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854735821020, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[2]
      value: It represents Caishen. They say he has the power to turn iron into gold!
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854735821020, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[3]
      value: Give your weapon to the statue to see what happens!
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854735821020, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[4]
      value: Talk to the statue!
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854735821020, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[5]
      value: Let's go!
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854735821020, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.size
      value: 6
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854735821020, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[0]
      value: "\xA1Es hora de volverse m\xE1s fuerte!"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854735821020, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[1]
      value: "\xBFVes esta estatua?"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854735821020, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[2]
      value: "Representa a Caishen. \xA1Dicen que tiene el poder de convertir el
        hierro en oro!"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854735821020, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[3]
      value: "Entrega tu arma a la estatua para ver qu\xE9 sucede."
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854735821020, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[4]
      value: "\xA1Habla con la estatua!"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854735821020, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[5]
      value: "\xA1Vamos!"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854735821020, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[0]
      value: Ta na hora de ficar mais forte!
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854735821020, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[1]
      value: "T\xE1 vendo essa est\xE1tua?"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854735821020, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[2]
      value: Ela representa Caishen. Dizem que ele tem o poder de transformar ferro
        em ouro!
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854735821020, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[3]
      value: "De a sua arma pra est\xE1tua pra ver o que acontece!"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854735821020, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[4]
      value: "Fale com a est\xE1tua!"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854735821020, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[5]
      value: Vamo Vamo
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854774054671, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854774054671, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854774054671, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[0]
      value: "\u547C\u2014\u2014"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854774054671, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[1]
      value: "\u597D\u4E86\uFF0C\u5728\u6211\u5FCD\u4E0D\u4F4F\u628A\u795E\u50CF\u62C6\u6210\u788E\u7247\u524D\uFF0C\u6211\u4EEC\u8D70\u5427"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854774054671, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[0]
      value: Phew!
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854774054671, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[1]
      value: Alright, let's move on before I break this statue to pieces.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854774054671, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854774054671, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[0]
      value: "\xA1Uf!"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854774054671, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[1]
      value: Bueno, sigamos antes de romper esta estatua en pedazos.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854774054671, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[0]
      value: Ufa
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854774054671, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[1]
      value: "Ta. Vamos adiante antes que eu quebre essa est\xE1tua na porrada"
      objectReference: {fileID: 0}
