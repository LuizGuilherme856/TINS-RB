    - target: {fileID: 8825811855103015527, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[0]
      value: "\xA1Ven aqu\xED!"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811855103015527, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[1]
      value: Hola, mi nombre es Lamlard Quacksworth El 2do.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811855103015527, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[2]
      value: "Estoy aqu\xED para ayudarte a matar a estos demonios malditos."
      objectReference: {fileID: 0}
    - target: {fileID: 8825811855103015527, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[3]
      value: 'La idea es simple:'
      objectReference: {fileID: 0}
    - target: {fileID: 8825811855103015527, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[4]
      value: DISPARAS HASTA QUE DEJEN DE MOVERSE
      objectReference: {fileID: 0}
    - target: {fileID: 8825811855103015527, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[5]
      value: 'Usa <sprite=12> para disparar o <sprite=74>      '
