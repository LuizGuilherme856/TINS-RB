    - target: {fileID: 8825811853230534567, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[1]
      value: Abra essa porta.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853230534567, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[2]
      value: "T\xE1 esperando o que?"
      objectReference: {fileID: 0}
