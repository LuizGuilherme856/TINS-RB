      value: Come here!
      objectReference: {fileID: 0}
    - target: {fileID: 8825811855103015527, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[1]
      value: Hi, my name is Lamlard Quacksworth The 2nd
      objectReference: {fileID: 0}
    - target: {fileID: 8825811855103015527, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[2]
      value: I'm here to help you kill these cursed demons
      objectReference: {fileID: 0}
    - target: {fileID: 8825811855103015527, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[3]
      value: 'The idea is simple:'
      objectReference: {fileID: 0}
    - target: {fileID: 8825811855103015527, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[4]
      value: YOU SHOOT UNTIL THEY STOP MOVING
