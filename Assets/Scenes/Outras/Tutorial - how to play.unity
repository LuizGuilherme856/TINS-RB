    - target: {fileID: 8825811853141191618, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[3]
      value: "\u6309\u4E0B <sprite=29> \u6216 <sprite=72> \u8FD1\u6218     "
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853141191618, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[0]
      value: Good!
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853141191618, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[1]
      value: 'Use <sprite=39> or <sprite=62> to reload!    '
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853141191618, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[2]
      value: By the way, do you still have that bread knife?
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853141191618, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[3]
      value: 'Use <sprite=29> or <sprite=72> to attack with the knife!!!    '
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853141191618, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853141191618, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[0]
      value: "\xA1Bien!"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853141191618, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[1]
      value: 'Usa <sprite=39> o <sprite=62> para recargar.     '
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853141191618, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[2]
      value: "Por cierto, \xBFtodav\xEDa tienes ese cuchillo de pan?"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853141191618, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[3]
      value: 'Usa <sprite=29> o <sprite=72> para atacar con el cuchillo.     '
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853141191618, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[0]
      value: Boa!
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853141191618, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[1]
      value: 'Use <sprite=39> ou <sprite=62> para recarregar.    '
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853141191618, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[2]
      value: "A prop\xF3sito, Voc\xEA ainda tem aquela faca de p\xE3o?"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853141191618, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[3]
      value: 'Use <sprite=29> ou <sprite=72> para atacar com a faca    '
      objectReference: {fileID: 0}
