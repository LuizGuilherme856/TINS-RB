    - target: {fileID: 8825811853039698895, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[0]
      value: "\u6709\u6548\u679C\u4E86!"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853039698895, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[1]
      value: "\u6211\u89C9\u5F97 .....\u4F60\u7684\u6B66\u5668\u5E94\u8BE5\u53D8\u5F97\u66F4\u5F3A\u4E86"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853039698895, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[0]
      value: It actually worked!
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853039698895, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[1]
      value: Your weapon is much stronger now... I hope.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853039698895, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853039698895, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[0]
      value: "No es que funcion\xF3."
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853039698895, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[1]
      value: "Tu arma ahora deber\xEDa estar mucho m\xE1s fuerte... espero."
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853039698895, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[0]
      value: "N\xE3o \xE9 que funcionou"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853039698895, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[1]
      value: "Sua arma est\xE1 bem mais forte agora\u2026 eu espero\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853076831833, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853076831833, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853076831833, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[0]
      value: "\u4F60\u6253\u5F00\u95E8\u771F\u662F\u592A\u597D\u4E86\uFF0C\u6211\u5728\u8FD9\u8981\u51BB\u6B7B\u4E86"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853076831833, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[0]
      value: It's good that you opened the door; I was cold.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853076831833, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853076831833, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[0]
      value: "Es bueno que hayas abierto la puerta; ten\xEDa fr\xEDo."
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853076831833, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[0]
      value: Que bom que abriu a porta, eu tava com frio.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853097427138, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spawnManager
      value: 
      objectReference: {fileID: 105924741}
    - target: {fileID: 8825811853097427138, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
