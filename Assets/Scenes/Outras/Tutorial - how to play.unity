      objectReference: {fileID: 0}
    - target: {fileID: 8825811853348022741, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[0]
      value: "\u4F60\u53EF\u4EE5\u8D2D\u4E70\u7B26\u6587\uFF0C\u6765\u53D8\u5F97\u66F4\u5F3A"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853348022741, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[1]
      value: "\u4E0D\u8FC7\u8FD9\u4E2A\u7B26\u6587\u73B0\u5728\u8FD8\u7528\u4E0D\u4E86\uFF0C\u4F60\u9700\u8981\u4E00\u4E9B\u796D\u54C1"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853348022741, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[0]
      value: You can buy runes to get stronger.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853348022741, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[1]
      value: But this one is unavailable for now. You need a sacrifice.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853348022741, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853348022741, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[0]
      value: "Puedes comprar runas para volverte m\xE1s fuerte."
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853348022741, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[1]
      value: "Pero esta est\xE1 no disponible por ahora. Necesitas un sacrificio"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853348022741, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[0]
      value: Voce pode comprar runas para ficar mais forte
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853348022741, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[1]
      value: "mas essa ta indisponivel ainda. Voc\xEA precisa de um sacrificio."
      objectReference: {fileID: 0}
