    - target: {fileID: 8825811853593790814, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[0]
      value: They're coming!
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853593790814, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[1]
      value: Kill them!
