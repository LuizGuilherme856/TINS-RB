      value: "\u8FD9\u91CC\uFF0C\u4E70\u628A\u65B0\u5200"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854793284443, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[1]
      value: "\u6211\u770B\u4F60\u624B\u91CC\u7684\u5200\uFF0C\u522E\u4E86\u592A\u591A\u6BDB\uFF0C\u5DF2\u7ECF\u53D8\u949D\u4E86"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854793284443, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[0]
      value: Here, buy a new knife.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854793284443, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[1]
      value: Yours must be dull from all the bread you've been cutting.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854793284443, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854793284443, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[0]
      value: "Aqu\xED, compra un cuchillo nuevo."
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854793284443, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[1]
      value: El tuyo ya debe estar ciego de tanto que comes pan.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854793284443, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[0]
      value: Aqui, compre uma faca nova.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854793284443, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[1]
      value: "A sua j\xE1 deve t\xE1 cega de tanto que voc\xEA come p\xE3o"
      objectReference: {fileID: 0}
