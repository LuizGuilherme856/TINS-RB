    - target: {fileID: 8825811854793500998, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[0]
      value: "\u5728\u796D\u575B\u9644\u8FD1\u6740\u6B7B\u5B83\u4EEC"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854793500998, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[1]
      value: "\u6740!\u6740!\u6740\u5149!"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854793500998, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[0]
      value: Kill them near the altar.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854793500998, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[1]
      value: KILLLLL THEM ALLLLLL
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854793500998, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854793500998, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[0]
      value: "M\xE1talos cerca del altar."
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854793500998, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[1]
      value: "\xA1M\xC1TALOS A TOOOODOS!"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854793500998, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[0]
      value: Mate eles perto do altar
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854793500998, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[1]
      value: MATEEEEE TODOSSS
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854819016347, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854819016347, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854819016347, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854819016347, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[0]
      value: "\u606D\u559C!\u4F60\u73B0\u5728\u662F\u4E2A\u5408\u683C\u7684\u5C60\u6740\u673A\u5668\u4E86!"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854819016347, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[1]
      value: "\u4F60\u53EF\u4EE5\u51FA\u5E08\u4E86"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854819016347, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.data[2]
      value: "\u8D70\u5427!\u79BB\u5F00\u8FD9\u91CC\uFF0C\u5411\u6559\u5802\u524D\u8FDB!"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854819016347, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[0]
      value: Congratulations, you're a killing machine now.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854819016347, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[1]
      value: You can go now.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854819016347, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: englishLines.Array.data[2]
      value: Let's go. Get outta here!
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854819016347, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854819016347, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[0]
      value: "Felicidades, ahora eres una m\xE1quina de matar."
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854819016347, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[1]
      value: Puedes irte ahora.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854819016347, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[2]
      value: "\xA1Vamos! \xA1Sal de aqu\xED!"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854819016347, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[0]
      value: "Parabens voc\xEA \xE9 uma maquina de morte agora"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854819016347, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[1]
      value: "J\xE1 pode ir embora. "
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854819016347, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[2]
      value: 'Vamos. Se manda! '
      objectReference: {fileID: 0}
    - target: {fileID: 8825811854931453545, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: buyWeaponStation
      value: 
      objectReference: {fileID: 1602490945}
