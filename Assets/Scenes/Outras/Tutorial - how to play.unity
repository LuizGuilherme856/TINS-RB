    - target: {fileID: 8825811855103015527, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[0]
      value: "Venha c\xE1!"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811855103015527, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[1]
      value: Oi, eu me chamo Lamlard o Segundo.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811855103015527, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[2]
      value: Estou aqui pra te ajudar a matar esses demonios malditos.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811855103015527, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[3]
      value: "A ideia \xE9 simples:"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811855103015527, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
