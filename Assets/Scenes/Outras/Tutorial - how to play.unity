    - target: {fileID: 8825811853597755188, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: spanishLines.Array.data[1]
      value: Adelante.
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853597755188, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[0]
      value: "Abra esse port\xE3o se tiver coragem"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853597755188, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: portugueseLines.Array.data[1]
      value: "Vai l\xE1 mach\xE3o"
      objectReference: {fileID: 0}
    - target: {fileID: 8825811853621596022, guid: 89086701134fe044bb998ff5433d0dc9, type: 3}
      propertyPath: chineseLines.Array.size
