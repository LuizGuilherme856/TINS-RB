      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: lineEnglish.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: lineSpanish.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'lineChinese.Array.data[0]'
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'lineChinese.Array.data[1]'
      value: "\u6211\u8981\u628A\u4F60\u6495\u6210\u788E\u7247!"
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'lineChinese.Array.data[2]'
      value: "\u4EC0\u4E48?   \u55F7\uFF0C\u6211\u4EE5\u4E3A\u4F60\u53D8\u6210\u9B54\u9B3C\u4E86"
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'lineChinese.Array.data[3]'
      value: "\u6B7B\u4E86\u7684\u6076\u9B54\u624D\u662F\u597D\u6076\u9B54"
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'lineChinese.Array.data[4]'
      value: "\u6211\u624D\u4E0D\u7A7F\u88E4\u5B50!   "
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'lineChinese.Array.data[5]'
      value: "\u8C01\u662F Mr Granade? "
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'lineChinese.Array.data[6]'
      value: "\u8C01\u770B\u6211\uFF0C\u6211\u5C31\u7ED9\u4ED6\u4E00\u8033\u5149"
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'lineChinese.Array.data[7]'
      value: "\u4F60\u4E0D\u80FD\u4E0D\u5E26\u5395\u7EB8\u5C31\u4E0A\u6218\u573A"
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'lineChinese.Array.data[8]'
      value: "\u4E3A\u4EC0\u4E48\u6211\u4E0D\u662F\u732B\u5462?   "
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'lineChinese.Array.data[9]'
      value: "\u522B\u5FD8\u4E86\u7ED9\u6E38\u620F\u5199\u8BC4\u8BBA!   \u7403\u7403\u5566!"
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'lineEnglish.Array.data[0]'
      value: "Voc\xEA conhece o Paulo?"
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'lineEnglish.Array.data[1]'
      value: I'm going to break you into pieces!
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'lineEnglish.Array.data[2]'
      value: What? Oh, I thought you were a demon.
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'lineEnglish.Array.data[3]'
      value: A good demon is a dead demon.
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'lineEnglish.Array.data[4]'
      value: I'm not wearing pants.
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'lineEnglish.Array.data[5]'
      value: 'Who is Mr Granade? '
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'lineEnglish.Array.data[6]'
      value: If he looks at me, I'm going to give him a beating.
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'lineEnglish.Array.data[7]'
      value: You can't go to war with a roll of toilet paper.
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'lineEnglish.Array.data[8]'
      value: Cats only poop in the sand.
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'lineEnglish.Array.data[9]'
      value: Have you reviewed the game on Steam?
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: linePortuguese.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'lineSpanish.Array.data[0]'
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'lineSpanish.Array.data[1]'
      value: Voy a romperte todito
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'lineSpanish.Array.data[2]'
      value: "\xBFQu\xE9? Ah, ya veo. Pens\xE9 que eras un demonio."
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'lineSpanish.Array.data[3]'
      value: Un buen demonio es un demonio muerto.
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'lineSpanish.Array.data[4]'
      value: No estoy usando pantalones.
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'lineSpanish.Array.data[5]'
      value: Si me mira, le voy a dar una paliza.
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'lineSpanish.Array.data[6]'
      value: "No se puede ir a la guerra con un rollo de papel higi\xE9nico."
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'lineSpanish.Array.data[7]'
      value: "\xBFYa evaluaste el juego en Steam?"
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'linePortuguese.Array.data[0]'
      value: "Voc\xEA conhece o Paulo?"
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'linePortuguese.Array.data[1]'
      value: Vou te quebrar todinho!
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'linePortuguese.Array.data[2]'
      value: "Que? Ah ta. Pensei que era um dem\xF4nio"
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'linePortuguese.Array.data[3]'
      value: "Dem\xF4nio bom \xE9 dem\xF4nio morto"
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'linePortuguese.Array.data[4]'
      value: "N\xE3o estou usando cal\xE7as"
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'linePortuguese.Array.data[5]'
      value: "Pow, qual \xE9, uh, ah, ufa"
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'linePortuguese.Array.data[6]'
      value: Mas bah, tri legal
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'linePortuguese.Array.data[7]'
      value: Irineu?
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'linePortuguese.Array.data[8]'
      value: O Dener ta online
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'linePortuguese.Array.data[9]'
      value: Se ele me olhar vou dar um pau nele
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'linePortuguese.Array.data[10]'
      value: "N\xE3o da pra ir pra guerra com um rolo de papel higi\xEAnico"
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'linePortuguese.Array.data[11]'
      value: "Japod al\u2019mosar?"
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'linePortuguese.Array.data[12]'
      value: "Pra matar galinha \xE9 s\xF3 torcer o pesco\xE7o"
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'linePortuguese.Array.data[13]'
      value: "Gato s\xF3 c4ga na areia"
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'linePortuguese.Array.data[14]'
      value: "J\xE1 avaliou o jogo na Steam? "
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'linePortuguese.Array.data[15]'
      value: Faz o L
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'linePortuguese.Array.data[16]'
      value: "\xC9 verdade que as mulheres de Novigrad raspam a x4n1nha?"
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'linePortuguese.Array.data[17]'
      value: "Endireita as costas a\xED, guerreiro"
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'linePortuguese.Array.data[18]'
      value: "Tomou \xE1gua hoje?"
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'linePortuguese.Array.data[19]'
      value: "O Palmeiras n\xE3o tem mundial"
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'linePortuguese.Array.data[20]'
      value: Mas bah tche
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'linePortuguese.Array.data[21]'
      value: 'Cucko hoje? '
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'linePortuguese.Array.data[22]'
      value: "Gato s\xF3 c4ga na areia"
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032523, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: 'linePortuguese.Array.data[23]'
      value: "Gato s\xF3 c4ga na areia"
      objectReference: {fileID: 0}
    - target: {fileID: 2770597783260032525, guid: ef7d7e565cc08fd4fb303e2fb88f89a8, type: 3}
      propertyPath: m_Name
      value: NPC behaviour
      objectReference: {fileID: 0}
