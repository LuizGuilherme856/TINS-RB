  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1803091472}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e85cb56be4a113641b8a13eb24726014, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  languageData: {fileID: 11400000, guid: eb0c907e1bf9b3e4b9c51bdece2e7eb6, type: 2}
  backgroundImage: {fileID: 1803091474}
  sfxFeedback: {fileID: 857378317}
  phrases:
  - english: Hell is at war with itself
    chinese: "\u5730\u72F1\u6B63\u5728\u4E0E\u81EA\u5DF1\u5F00\u6218"
    portuguese: "O inferno est\xE1 em guerra consigo mesmo"
    spanish: "El infierno est\xE1 en guerra consigo mismo"
    duration: 1
  - english: Leaderless, the demons roam like ravenous beasts...
    chinese: "\u6CA1\u6709\u9886\u8896\uFF0C\u6076\u9B54\u50CF\u9965\u997F\u7684\u91CE\u517D\u822C\u6E38\u8361\u2026\u2026"
    portuguese: "Sem l\xEDderes, os dem\xF4nios vagam como bestas famintas..."
    spanish: "Sin l\xEDderes, los demonios deambulan como bestias hambrientas..."
    duration: 1
  - english: And as chaos reigns below, the Earth bleeds above
    chinese: "\u5F53\u6DF7\u4E71\u5728\u4E0B\u65B9\u7EDF\u6CBB\uFF0C\u5730\u9762\u4E4B\u4E0A\u4E5F\u5728\u6D41\u8840"
    portuguese: E enquanto o caos reina abaixo, a Terra sangra acima
    spanish: Y mientras el caos reina abajo, la Tierra sangra arriba
    duration: 0.7
  - english: 'Azaus descends... '
    chinese: "\u4E9A\u745F\u65AF\u4E0B\u6C89\u2026\u2026"
    portuguese: 'Azaus desce... '
    spanish: 'Azaus desciende... '
    duration: 0.2
  - english: not to save souls, but to confront the imbalance.
    chinese: "\u4E0D\u662F\u4E3A\u4E86\u62EF\u6551\u7075\u9B42\uFF0C\u800C\u662F\u4E3A\u4E86\u5BF9\u6297\u5931\u8861\u3002"
    portuguese: "n\xE3o para salvar almas, mas para confrontar o desequil\xEDbrio."
    spanish: no para salvar almas, sino para enfrentar el desequilibrio.
    duration: 1
  uiText: {fileID: 402875898}
  canvasGroup: {fileID: 402875901}
  fadeTime: 1
